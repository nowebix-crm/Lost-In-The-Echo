{
  "name": "lost-in-the-echo",
  "version": "1.0.0",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/index.ts && npx tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:up": "tsx ./src/migrate up",
    "migrate:down": "tsx ./src/migrate down",
    "migrate:create": "npx sequelize-cli model:generate --name $NAME --attributes default_field:string",
    "docker:build": "docker build -t lost-in-the-echo .",
    "docker:run": "docker run -p 3001:3001 lost-in-the-echo",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:prod": "docker-compose up -d",
    "docker:prod:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.5",
    "@types/typescript": "^2.0.0",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.3"
  },
  "dependencies": {
    "@sequelize/postgres": "^7.0.0-alpha.45",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "umzug": "^3.8.2"
  }
}
